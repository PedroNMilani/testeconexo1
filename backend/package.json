{
  "name": "conexo-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "db:init": "node --env-file-if-exists=.env scripts/init-db.js",
    "seed:aacd": "node --env-file-if-exists=.env scripts/seed-aacd.js",
    "test": "node --env-file-if-exists=.env.test --test --test-concurrency=1 tests/*.test.js"
  },
  "dependencies": {
    "@turf/boolean-point-in-polygon": "^7.4.0",
    "bcrypt": "^6.0.0",
    "express": "^5.3.0",
    "express-mysql-session": "^3.0.3",
    "express-rate-limit": "^8.7.4",
    "express-session": "^1.19.0",
    "leaflet": "^1.9.4",
    "mongodb": "^6.22.0",
    "mysql2": "^3.24.6"
  }
}
